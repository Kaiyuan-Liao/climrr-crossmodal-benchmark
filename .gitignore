# machine-specific config (real paths live here, never tracked)
config/local_paths.yaml

# environments
.venv*
.venv*/
.env

# python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# secrets / credentials
*.pem
*.key

# large / regenerable outputs
artifacts/**/large/
outputs/
*.npy
*.npz
*.parquet
*.pkl

# raw data is transferred out of band, never tracked (decision D-005).
# Its bytes are pinned by SHA-256 in data/manifest.json instead of by a commit.
data/raw/*.csv

# external literature corpus must never enter this repo
literature/
# ...except the M4-WP0 inventory artifacts, which hold manifests, hashes and
# summaries only --- never a corpus file (D-015; tests/test_corpus.py).
!artifacts/literature/

# os
.DS_Store

# knowledge-refresh staging area (scripts/stage_knowledge.py); copies, never evidence
refresh_knowledge/

# Track D v1 filled questions: ~14 MB, regenerable from tracked inputs and the
# hash-pinned table; pinned by SHA-256 in questions_v1_summary.json instead.
artifacts/templates/questions_v1.jsonl
artifacts/benchmark/table_patterns_v1.jsonl
# Pilot P2a item seeds: ~58 MB, regenerable from the tracked clusters and the pinned
# table patterns; pinned by SHA-256 in item_seeds_v1_summary.json. The review workbook
# is regenerable too; its SEEDS sheet is tracked as P2a_seeds_v1.csv.
artifacts/benchmark/item_seeds_v1.jsonl
# Pilot P2b-prep item seeds v2: regenerable likewise; pinned in item_seeds_v2_summary.json.
artifacts/benchmark/item_seeds_v2.jsonl
artifacts/benchmark/review/*.xlsx
