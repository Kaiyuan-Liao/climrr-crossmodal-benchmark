  "raw_response": "{\n  \"statements\": [\n    {\n      \"statement\": \"High temperature extremes can cause thermal sagging of overhead transmission lines, increasing the risk of short circuits and outages.\",\n      \"statement_type\": \"impact\",\n      \"passage\": \"Highs of temperature, which may reduce the ability of transformers to shed heat, and also leads to sagging in overhead lines from thermal expansion, increasing the potential for short circuits.\",\n      \"section_key\": \"natural phenomena and power system impacts\",\n      \"passage_type\": \"own_finding\",\n      \"region\": \"unknown\",\n      \"region_scope\": \"global\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"general_mechanism\",\n      \"confidence\": \"high\",\n      \"hazard_term\": \"high temperatures\",\n      \"asset_class\": \"energy\",\n      \"impact_mechanism\": \"thermal expansion causes line sagging\",\n      \"impact_outcome\": \"increased likelihood of short‑circuit faults and power outages\"\n    },\n    {\n      \"statement\": \"Extreme heat can increase the probability of wildfires, which may damage transmission infrastructure and trigger circuit trips.\",\n      \"statement_type\": \"impact\",\n      \"passage\": \"Secondary, high temperatures may also induce wildfires, which can cause tripping of transmission circuits and damage to network equipment.\",\n      \"section_key\": \"natural phenomena and power system impacts\",\n      \"passage_type\": \"own_finding\",\n      \"region\": \"unknown\",\n      \"region_scope\": \"global\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"general_mechanism\",\n      \"confidence\": \"high\",\n      \"hazard_term\": \"high temperatures\",\n      \"asset_class\": \"energy\",\n      \"impact_mechanism\": \"heat‑driven wildfires ignite near lines\",\n      \"impact_outcome\": \"damage to equipment and automatic circuit trips\"\n    },\n    {\n      \"statement\": \"Heat waves are expected to become more frequent and intense with climate change, especially in urban areas where heat‑island effects amplify temperatures.\",\n      \"statement_type\": \"driver\",\n      \"passage\": \"High temperature extremes are also likely to significantly increase as averages rise globally, with a particular impact on urban areas where heat islands exacerbate the effect (Wang et al 2021).\",\n      \"section_key\": \"adaptation to climate change\",\n      \"passage_type\": \"review_synthesis\",\n      \"region\": \"global\",\n      \"region_scope\": \"global\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"regional_expectation\",\n      \"confidence\": \"medium\",\n      \"hazard_term\": \"heat waves\",\n      \"asset_class\": \"\",\n      \"impact_mechanism\": \"\",\n      \"impact_outcome\": \"\"\n    },\n    {\n      \"statement\": \"In regions prone to wildfires, electricity network faults can themselves ignite fires, making fault mitigation a key element of wildfire prevention.\",\n      \"statement_type\": \"mechanism\",\n      \"passage\": \"Network faults can be the cause of wildfires, and mitigation of electricity network faults is a key element of wildfire prevention (Miller et al 2017).\",\n      \"section_key\": \"adaptation to climate change\",\n      \"passage_type\": \"review_synthesis\",\n      \"region\": \"wildfire‑prone areas\",\n      \"region_scope\": \"regional\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"general_mechanism\",\n      \"confidence\": \"high\",\n      \"hazard_term\": \"wildfire\",\n      \"asset_class\": \"\",\n      \"impact_mechanism\": \"\",\n      \"impact_outcome\": \"\"\n    },\n    {\n      \"statement\": \"Future climate projections suggest that the frequency of extreme heat events will rise, increasing stress on power system components and the need for upgraded design standards.\",\n      \"statement_type\": \"driver\",\n      \"passage\": \"One likely impact of climate change is the potential for certain extreme weather events‑dependent on location‑to increase in frequency and extent.\",\n      \"section_key\": \"adaptation to climate change\",\n      \"passage_type\": \"background\",\n      \"region\": \"unknown\",\n      \"region_scope\": \"global\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"regional_expectation\",\n      \"confidence\": \"medium\",\n      \"hazard_term\": \"extreme heat\",\n      \"asset_class\": \"\",\n      \"impact_mechanism\": \"\",\n      \"impact_outcome\": \"\"\n    }\n  ]\n}",
