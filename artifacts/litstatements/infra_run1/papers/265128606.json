  "raw_response": "{\n  \"statements\": [\n    {\n      \"statement\": \"Heat from nearby wildfires lowers the current‑carrying capacity of transmission conductors, which can create overloaded cut‑sets and increase the risk of cascading line outages.\",\n      \"statement_type\": \"impact\",\n      \"passage\": \"Overloads occur because the heat from the fires affect the power lines in their vicinity resulting in lowering of the conductor's current carrying capacity.\",\n      \"section_key\": \"i. introduction\",\n      \"passage_type\": \"background\",\n      \"region\": \"unknown\",\n      \"region_scope\": \"unknown\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"general_mechanism\",\n      \"confidence\": \"high\",\n      \"hazard_term\": \"wildfire\",\n      \"asset_class\": \"energy\",\n      \"impact_mechanism\": \"heat reduces conductor capacity\",\n      \"impact_outcome\": \"overloads and cascading outages\"\n    },\n    {\n      \"statement\": \"Wildfire‑induced arc‑faults can occur repeatedly within seconds, producing multiple transient disturbances that threaten rotor‑angle stability of the power system.\",\n      \"statement_type\": \"impact\",\n      \"passage\": \"Wildfire induced arc‑faults are unique as they occur multiple times within a few seconds.\",\n      \"section_key\": \"i. introduction\",\n      \"passage_type\": \"background\",\n      \"region\": \"unknown\",\n      \"region_scope\": \"unknown\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"general_mechanism\",\n      \"confidence\": \"high\",\n      \"hazard_term\": \"wildfire\",\n      \"asset_class\": \"energy\",\n      \"impact_mechanism\": \"multiple rapid arc‑faults\",\n      \"impact_outcome\": \"threaten transient stability\"\n    },\n    {\n      \"statement\": \"Pre‑emptive de‑energisation of transmission lines to avoid fire‑induced faults can cause large‑scale electricity outages and high social costs.\",\n      \"statement_type\": \"impact\",\n      \"passage\": \"During the 2019 California fires, preemptive actions by the local utility left more than 2.7 million people without electricity.\",\n      \"section_key\": \"i. introduction\",\n      \"passage_type\": \"cited_finding\",\n      \"region\": \"California\",\n      \"region_scope\": \"subnational\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"2019\",\n      \"time_source\": \"in_passage\",\n      \"time_quote\": \"2019\",\n      \"time_location\": \"i. introduction\",\n      \"generality\": \"regional_expectation\",\n      \"confidence\": \"medium\",\n      \"hazard_term\": \"wildfire\",\n      \"asset_class\": \"energy\",\n      \"impact_mechanism\": \"pre‑emptive line shutdowns\",\n      \"impact_outcome\": \"mass electricity outages\"\n    },\n    {\n      \"statement\": \"Dynamic stability constraints that account for fire‑induced arc‑faults can be incorporated into optimal power flow models to prevent generator tripping during wildfire events.\",\n      \"statement_type\": \"mechanism\",\n      \"passage\": \"The proposed CSCOPF is able to alleviate cascading outages due to static and dynamic insecurities with minimal increase in operational cost.\",\n      \"section_key\": \"iv. results\",\n      \"passage_type\": \"own_finding\",\n      \"region\": \"unknown\",\n      \"region_scope\": \"unknown\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"specific_result\",\n      \"confidence\": \"high\",\n      \"hazard_term\": \"\",\n      \"asset_class\": \"\",\n      \"impact_mechanism\": \"\",\n      \"impact_outcome\": \"\"\n    },\n    {\n      \"statement\": \"Arc‑faults caused by wildfires can trigger transient instability that requires rapid generation redispatch to maintain system synchronism.\",\n      \"statement_type\": \"impact\",\n      \"passage\": \"During implementation, the RT‑SCED did not reschedule sufficient generation for ensuring transient stability as it did not have any dynamic information (power from CMs was only lowered by 20 MW as compared to the minimum needed 118 MW shown in Table I).\",\n      \"section_key\": \"b. cscopf implementation results\",\n      \"passage_type\": \"own_finding\",\n      \"region\": \"unknown\",\n      \"region_scope\": \"unknown\",\n      \"scenario\": \"unknown\",\n      \"scenario_source\": \"unknown\",\n      \"scenario_quote\": \"\",\n      \"scenario_location\": \"\",\n      \"time\": \"unknown\",\n      \"time_source\": \"unknown\",\n      \"time_quote\": \"\",\n      \"time_location\": \"\",\n      \"generality\": \"specific_result\",\n      \"confidence\": \"medium\",\n      \"hazard_term\": \"wildfire\",\n      \"asset_class\": \"energy\",\n      \"impact_mechanism\": \"arc‑faults cause transient instability\",\n      \"impact_outcome\": \"require generation redispatch\"\n    }\n  ]\n}",
