# Raw data files are byte-immutable. Never let Git rewrite line endings or
# attempt textual diffs/merges on them: a single CRLF normalisation would
# break the SHA-256 byte-identity gate that the whole project depends on.
*.csv -text -diff binary
*.pdf -text -diff binary

# Everything else: normalise to LF in the repository.
* text=auto eol=lf

# The literature collection query (M4-WP0) is pinned by SHA-256 in
# data/manifest.json. Git must never rewrite it, even though it is plain text.
data/metadata/literature_query.txt -text
