# Raw data files are byte-immutable. Never let Git rewrite line endings or
# attempt textual diffs/merges on them: a single CRLF normalisation would
# break the SHA-256 byte-identity gate that the whole project depends on.
*.csv -text -diff binary
*.pdf -text -diff binary

# Everything else: normalise to LF in the repository.
* text=auto eol=lf

# The literature collection query (M4-WP0) is pinned by SHA-256 in
# data/manifest.json. Git must never rewrite it, even though it is plain text.
data/metadata/literature_query.txt -text

# M4-WP3: the collection evidence and the frozen corpus records are pinned by
# SHA-256 (705k_stage1_hashes.txt, redactions.json, data/manifest.json); some
# evidence CSVs use CRLF as received. Byte-exact: Git must never rewrite them.
# (The `* text=auto` line above takes precedence over `*.csv -text`, so the
# rule has to be restated after it for these paths.)
artifacts/literature/litcorpus01/** -text
artifacts/literature/litcorpus02/** -text

# Track B Stage 2a (D-025): the dictionary concept inventory and the survey
# context clause are pinned by SHA-256 in data/manifest.json. Byte-exact.
data/metadata/dictionary_concepts.yaml -text
data/metadata/litcollect/** -text

# Track B survey runs 1 and 2 (D-025, D-026, D-027): each pinned by its manifest.csv, whose SHA-256 is in
# data/manifest.json under `diagnostics`. Byte-exact.
artifacts/literature/survey/** -text

# Track C soft-QA schema, protocol form and inputs (D-033): pinned by SHA-256 in
# data/manifest.json. Byte-exact.
data/metadata/softqa/** -text

# Track C run 1 ingest, locator replay and review batch 01 (D-033): pinned by manifest.csv / SHA-256 in
# data/manifest.json. Byte-exact.
artifacts/softqa/** -text

# Pilot P1 (D-041): the NCA5 state -> region map and the item schema v2 are
# pinned by SHA-256 in data/manifest.json. Byte-exact.
data/metadata/geography/** -text
data/metadata/benchmark/** -text
